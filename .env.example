# From https://developers.tiktok.com -> Manage apps -> your app -> Credentials
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret

# Exactly ONE base URL (no "||" fallbacks - env files do not support them).
# Must exactly match a redirect URL registered in the TikTok developer portal
# under Login Kit, in the mode you are testing in (Sandbox or Production).
# The callback URI generated from this is: <NEXT_PUBLIC_APP_URL>/api/tiktok/callback
# e.g. http://localhost:3000 or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
